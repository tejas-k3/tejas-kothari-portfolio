---
import Base from "../layouts/Base.astro";
import "../styles/blog.css";
import { categories, allSeries, getPosts } from "../lib/blog";
// Private writing desk: not linked from anywhere, noindex, and useless without the GitHub token that only
// the owner can unlock (see src/scripts/write.ts). Nothing here is secret; the token is.
const posts = await getPosts();
const cats = categories(posts).map((c) => c.name);
const series = allSeries(posts).map((s) => s.name);
const today = new Date().toISOString().slice(0, 10);
---
<Base title="Write | Tejas Kothari" description="Private writing desk." path="/write">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="wrap wr" data-write data-repo="tejas-k3/tejas-kothari-portfolio" data-branch="tejas-v3" data-today={today}>
    <p class="eyebrow">Write</p>
    <h1>Writing desk</h1>

    <section class="gate card" data-gate>
      <form data-setup hidden>
        <p class="why">First time on this device. Paste a fine-grained GitHub token (this repo only, <b>Contents: read &amp; write</b>) and choose a password for the editor. The token is stored encrypted with that password; the password itself is never stored.</p>
        <label>GitHub token<input type="password" name="token" autocomplete="off" required /></label>
        <label>Editor password<input type="password" name="pw" autocomplete="new-password" minlength="12" required /></label>
        <label>Repeat password<input type="password" name="pw2" autocomplete="new-password" minlength="12" required /></label>
        <button class="btn primary" type="submit">Save &amp; open</button>
      </form>
      <form data-unlock hidden>
        <p class="why">Enter the editor password.</p>
        <label class="sr" for="wpw">Editor password</label>
        <div class="row"><input id="wpw" type="password" name="pw" autocomplete="current-password" required /><button class="btn primary" type="submit">Open</button></div>
        <button type="button" class="linkish" data-forget>Forget this device's token</button>
      </form>
      <p class="msg mono" data-gmsg role="status" aria-live="polite"></p>
    </section>

    <section data-editor hidden>
      <div class="bar">
        <span class="mono who" data-who></span>
        <button type="button" class="linkish" data-lock>Lock editor</button>
      </div>
      <div class="tabs" role="tablist" aria-label="Writing desk">
        <button type="button" class="chip" role="tab" data-tab="write" aria-selected="true">Write</button>
        <button type="button" class="chip" role="tab" data-tab="manage" aria-selected="false">Manage posts</button>
      </div>

      <section data-pane="manage" hidden>
        <p class="why">Everything on <code>tejas-v3</code>. Editing or deleting commits straight to the branch. Deleting a public post removes it from the site but not from git history.</p>
        <p class="msg mono" data-lmsg role="status" aria-live="polite"></p>
        <ul class="plist" data-list></ul>
        <form class="purge" data-purge autocomplete="off">
          <p class="why"><b>Purge a path from history</b> (for posts already deleted, e.g. test posts). Enter a slug for a public post, or a full path such as <code>src/content/sealed/my-post.json</code>.</p>
          <label class="sr" for="ppath">Path or slug</label>
          <input id="ppath" name="path" placeholder="slug or full path" />
          <div class="acts" data-purge-act></div>
        </form>
      </section>

      <div data-pane="write">
      <p class="editing card" data-editing hidden><span>Editing <b data-eslug></b></span><button type="button" class="linkish" data-cancel>Cancel</button></p>
      <form class="ed" data-form autocomplete="off">
        <div class="grid2">
          <label>Title<input name="title" required /></label>
          <label>Slug<input name="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="auto from title" /></label>
          <label>Date<input name="date" type="date" required value={today} /></label>
          <label>Category<input name="category" list="cats" required placeholder="Tech" /></label>
          <label>Tags <small>(comma separated)</small><input name="tags" /></label>
          <label>Summary <small>(optional, one line)</small><input name="summary" /></label>
          <label>Series <small>(optional)</small><input name="series" list="sers" /></label>
          <label>Part <small>(with series)</small><input name="part" type="number" min="1" /></label>
        </div>
        <datalist id="cats">{cats.map((c) => <option value={c} />)}</datalist>
        <datalist id="sers">{series.map((s) => <option value={s} />)}</datalist>

        <div class="opts">
          <label class="chk"><input type="checkbox" name="draft" /> Draft <small>(hidden on the site; the text is still in the public repo)</small></label>
          <label class="chk"><input type="checkbox" name="locked" /> Locked <small>(encrypted in this browser; only ciphertext is committed)</small></label>
          <label class="chk" data-secret hidden><input type="checkbox" name="secretTitle" /> Hide title too</label>
        </div>
        <label data-bpw hidden>Blog password <small>(the one you use for <code>bun run seal</code>; never stored)</small><input type="password" name="bpw" autocomplete="off" /></label>

        <div class="split">
          <label class="body">Markdown<textarea name="body" rows="22" required spellcheck="true"></textarea></label>
          <div class="pv"><p class="eyebrow">Preview</p><div class="prose" data-preview></div></div>
        </div>

        <div class="act">
          <button class="btn primary" type="submit" data-publish>Publish to tejas-v3</button>
          <span class="msg mono" data-msg role="status" aria-live="polite"></span>
        </div>
      </form>
      </div>
    </section>
  </main>
  <script>import "../scripts/write";</script>
</Base>
<style>
  .wr { padding-top: clamp(32px, 6vw, 72px); padding-bottom: 72px; }
  h1 { font-size: clamp(34px, 5vw, 56px); font-weight: 800; letter-spacing: -.03em; margin: 10px 0 24px; }
  .gate { max-width: 480px; display: grid; gap: 12px; }
  .gate[hidden], [hidden] { display: none !important; }
  .gate form { display: grid; gap: 12px; }
  .why { color: var(--muted); font-size: 15px; }
  label { display: grid; gap: 6px; font-size: 13px; color: var(--muted); }
  label small { color: var(--muted); opacity: .8; }
  input:not([type="checkbox"]), textarea { min-height: 44px; padding: 0 14px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font: 16px var(--font-body); width: 100%; }
  textarea { padding: 14px; font: 15px/1.6 var(--font-mono); resize: vertical; }
  input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; } .row input { flex: 1 1 200px; }
  .linkish { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 13px; justify-self: start; padding: 0; }
  .msg { font-size: 13px; color: var(--danger); min-height: 1.2em; } .msg.ok { color: var(--success); }
  .bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; font-size: 12px; color: var(--muted); }
  .ed { display: grid; gap: 16px; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .chk { display: flex; align-items: center; gap: 8px; color: var(--text); font-size: 14px; }
  .split { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 1000px) { .split { grid-template-columns: 1fr 1fr; align-items: start; } }
  .pv { border: 1px solid var(--border); border-radius: 12px; padding: 16px 20px; min-height: 200px; overflow: auto; }
  .pv .prose { font-size: 16px; }
  .act { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 20px; }
  .tabs .chip { cursor: pointer; padding: 7px 14px; font-size: 13px; }
  .tabs .chip[aria-selected="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .editing { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; padding: 12px 16px; font-size: 14px; }
  .plist { list-style: none; padding: 0; display: grid; gap: 10px; margin-top: 12px; }
  .plist li { display: grid; gap: 8px; border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; }
  .plist .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; justify-content: space-between; }
  .plist .t { font-weight: 600; }
  .plist .m { font: 12px var(--font-mono); color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .plist .badge { color: var(--accent); }
  .plist .acts { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .plist .acts .btn { min-height: 34px; padding: 0 14px; font-size: 13px; }
  .plist .acts input { max-width: 240px; min-height: 34px; font-size: 14px; }
  .plist .danger { color: var(--danger); border-color: var(--danger); }
  .purge { display: grid; gap: 10px; margin-top: 28px; max-width: 560px; }
  .purge .acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .purge .btn { min-height: 34px; padding: 0 14px; font-size: 13px; }
  .purge .danger { color: var(--danger); border-color: var(--danger); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
