---
import Base from "../../layouts/Base.astro";
import ArchExplorer from "../../components/ArchExplorer.astro";
import ArchDiagram from "../../components/ArchDiagram.astro";
import { caseStudies } from "../../data/caseStudies";
import { evidence } from "../../data/evidence";
import { person } from "../../data/content";
export function getStaticPaths() { return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
// TODO(tejas) placeholders are visible in dev only; never shown on the deployed site.
const change = c.change.filter((x) => import.meta.env.DEV || !x.startsWith("TODO(tejas)"));
const ev = evidence[c.slug];
---
<Base title={`${c.ogTitle} | Tejas Kothari`} description={c.blurb} path={`/projects/${c.slug}`} type="article">
  <article class="wrap cs">
    <nav aria-label="Breadcrumb" class="crumb mono"><a href="/">Home</a> / <a href="/work">Work</a> / {c.name}</nav>
    <header>
      <p class="eyebrow">Case study</p>
      <h1>{c.name}</h1>
      <p class="lede">{c.blurb}</p>
      <dl class="facts">{c.facts.map((f) => <div><dt class="mono">{f.k}</dt><dd>{f.v}</dd></div>)}</dl>
      {c.links.length > 0 && <p class="ls">{c.links.map((l) => <a class="btn" href={l.h} target="_blank" rel="noopener">{l.t} ↗</a>)}</p>}
      {ev && (
        <ul class="glance" id="impact" aria-label="Impact">
          {ev.impact.map((m) => <li><b>{m.big}</b><span>{m.label}</span><em>{m.note}</em></li>)}
        </ul>
      )}
    </header>

    <section>
      <h2>The problem</h2>
      <p>{c.problem}</p>
      <p>{c.context}</p>
    </section>
    <section id="architecture">
      <h2>Architecture</h2>
      {ev && <ArchDiagram d={ev.diagram} />}
      <h3 class="sub">Explore the stages</h3>
      <ArchExplorer nodes={c.arch} />
    </section>

    {ev && (
      <>
        <section id="decisions">
          <h2>Decisions that mattered</h2>
          <div class="stories">
            {ev.stories.map((st) => (
              <article class="story card">
                <h3>{st.title}</h3>
                <dl><dt class="mono">Situation</dt><dd>{st.situation}</dd><dt class="mono">What I decided</dt><dd>{st.decision}</dd><dt class="mono">Result</dt><dd>{st.result}</dd></dl>
              </article>
            ))}
          </div>
        </section>
        <section id="principles">
          <h2>What I optimise for</h2>
          <ul class="chips">{ev.principles.map((x) => <li>{x}</li>)}</ul>
          {ev.practice && <p class="practice">{ev.practice}</p>}
        </section>
        <section id="gaps">
          <h2>Known gaps and what is next</h2>
          <ul class="gaps">{ev.gaps.map((g) => <li class="card"><p>{g.gap}</p><p class="next"><span class="mono">Next</span> {g.next}</p></li>)}</ul>
        </section>
      </>
    )}

    {change.length > 0 && <section><h2>What I would change today</h2><ul>{change.map((x) => <li>{x}</li>)}</ul></section>}
    <p class="back"><a class="btn" href="/work">← All work</a> <a class="btn primary" href={person.linkedin} target="_blank" rel="noopener">Let's talk →</a></p>
  </article>
</Base>
<style>
  .cs { padding-top: 32px; padding-bottom: 64px; max-width: 920px; }
  .crumb { font-size: 12px; color: var(--muted); margin-bottom: 32px; } .crumb a { color: var(--muted); }
  h1 { font-size: clamp(38px, 7vw, 72px); font-weight: 800; margin-top: 14px; letter-spacing: -.035em; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; margin: 32px 0 0; padding: 20px 0; border-block: 1px solid var(--border); }
  dt { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); } dd { margin: 4px 0 0; font-weight: 500; }
  .ls { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
  .glance { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
  .glance li { border: 1px solid var(--accent); border-radius: 14px; padding: 18px; background: color-mix(in srgb, var(--accent) 7%, var(--surface)); display: grid; gap: 6px; align-content: start; }
  .glance b { font: 800 clamp(30px, 5vw, 40px) var(--font-display); letter-spacing: -.02em; color: var(--accent); line-height: 1; } .glance span { font-weight: 600; } .glance em { font-style: normal; color: var(--muted); font-size: 14px; }
  .cs section { padding: 44px 0 0; } h2 { font-size: clamp(24px, 3.4vw, 34px); margin-bottom: 14px; } h3.sub { font-size: 18px; margin: 28px 0 10px; }
  .cs p, .cs li { color: var(--muted); font-size: 17px; max-width: 72ch; } .cs section > p + p { margin-top: 12px; } ul { padding-left: 20px; display: grid; gap: 8px; }
  .stories { display: grid; gap: 14px; margin-top: 16px; } .story h3 { font-size: 20px; margin-bottom: 12px; } .story dl { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 8px 20px; margin: 0; } .story dd { font-weight: 400; color: var(--muted); font-size: 16px; margin: 0; }
  .chips { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); gap: 10px; margin-top: 12px; } .chips li { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--surface); color: var(--text); font-size: 15px; }
  .practice { margin-top: 14px; font-size: 15px !important; }
  .gaps { list-style: none; padding: 0; display: grid; gap: 10px; margin-top: 12px; } .gaps li { display: grid; gap: 6px; } .gaps p { font-size: 16px; } .gaps .next { color: var(--text); font-size: 15px; } .gaps .next span { color: var(--accent); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; margin-right: 6px; }
  .back { margin-top: 56px; display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 640px) { .story dl { grid-template-columns: 1fr; gap: 2px; } .story dd { margin-bottom: 8px; } }
</style>
