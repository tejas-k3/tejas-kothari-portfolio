---
import Base from "../layouts/Base.astro";
---
<Base title="404 | Tejas Kothari" description="This route appears to have distributed itself somewhere else." path="/404">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This route appears to have<br />distributed itself somewhere else.</h1> <!-- TODO(tone) -->
    <p class="lede">The page you wanted isn't here, but the good stuff is.</p>
    <p class="act"><a class="btn primary" href="/">← Go home</a> <a class="btn" href="/#work">See the work</a></p>
  </div>
</Base>
<style>
  .nf { padding-top: 12vh; padding-bottom: 14vh; } h1 { font-size: clamp(32px, 6vw, 64px); font-weight: 800; margin-top: 16px; letter-spacing: -.03em; }
  .act { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
</style>
