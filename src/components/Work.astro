---
import SectionHead from "./SectionHead.astro";
import { projects } from "../data/content";
import { caseStudies } from "../data/caseStudies";
const cs = (slug: string) => caseStudies.find((c) => c.slug === slug);
const [flagship, ...rest] = projects;
const major = projects.filter((p) => p.page);
const minor = projects.filter((p) => !p.page);
---
<section id="work" data-chapter="Projects" aria-label="Selected work">
  <div class="wrap">
    <SectionHead eyebrow="Selected work" title="Things I actually built." lede="Each one answers four questions: what, why, how, and what came out of it." />
    <div class="list">
      {major.map((p) => (
        <article class="card proj reveal">
          <div class="top">
            <h3><a href={p.page}>{p.name}</a></h3>
            <span class="chip">{p.tag}</span><span class="chip">{p.status}</span><span class="dates mono">{p.dates}</span>
          </div>
          <div class="what diff" data-diff>
            <p class="old mono" aria-hidden="true"><span class="sg">-</span>{p.brief}</p>
            <p class="new"><span class="sg mono" aria-hidden="true">+</span><span>{p.what}</span></p>
            <button type="button" class="dtoggle mono" data-dtoggle aria-pressed="false" title="Show the brief to build diff">⇄ diff</button>
          </div>
          <dl>
            <div><dt>Why</dt><dd>{p.why}</dd></div>
            <div><dt>How</dt><dd>{p.how}</dd></div>
            <div><dt>Result</dt><dd>{p.result}</dd></div>
          </dl>
          {cs(p.slug) && (
            <div class="eng-only under">
              <h4 class="mono">Under the hood</h4>
              <p class="flow">{cs(p.slug)!.arch.map((n, i) => <span><b class="mono">{String(i + 1).padStart(2, "0")}</b>{n.label}</span>)}</p>
              <div class="cols">
                <div><h5 class="mono">Key decisions</h5><ul>{cs(p.slug)!.decisions.slice(0, 3).map((d) => <li><b>{d.q}</b> {d.a}</li>)}</ul></div>
                <div><h5 class="mono">Trade-offs</h5><ul>{cs(p.slug)!.tradeoffs.map((t) => <li>{t}</li>)}</ul></div>
              </div>
            </div>
          )}
          <div class="foot">
            <p class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</p>
            <p class="act">
              <a class="btn primary" href={p.page} data-event="project_opened">Case study →</a>
              {p.repo && <a class="btn" href={p.repo} target="_blank" rel="noopener">GitHub ↗</a>}
            </p>
          </div>
        </article>
      ))}
    </div>
    <h3 class="more reveal">More projects</h3>
    <div class="minor">
      {minor.map((p) => (
        <article class="card reveal">
          <div class="top"><h3>{p.name}</h3><span class="chip">{p.tag}</span><span class="dates mono">{p.dates}</span></div>
          <p class="what">{p.what}</p>
          <p class="res">{p.result}</p>
          <p class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</p>
          {p.href && <p><a href={p.href} target="_blank" rel="noopener" class="ext">Visit site ↗</a></p>}
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const reduceM = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-diff]").forEach((d) => {
    const toggle = d.querySelector<HTMLButtonElement>("[data-dtoggle]")!;
    toggle.addEventListener("click", () => { const on = d.classList.toggle("show"); toggle.setAttribute("aria-pressed", String(on)); });
    if (reduceM) return;
    new IntersectionObserver((es, o) => { if (!es[0].isIntersecting) return; o.disconnect(); d.classList.add("play"); setTimeout(() => d.classList.add("strike"), 1100); setTimeout(() => { d.classList.remove("play", "strike"); d.classList.add("done"); }, 2900); }, { threshold: 0.6 }).observe(d);
  });
</script>
<style>
  .list { display: grid; gap: 20px; margin-top: 40px; }
  .proj { padding: clamp(20px, 3vw, 36px); }
  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .top h3 { font-size: clamp(22px, 3vw, 32px); margin-right: 6px; }
  .top h3 a { text-decoration: none; } .top h3 a:hover { color: var(--accent); }
  .dates { margin-left: auto; color: var(--muted); font-size: 12px; }
  .what { font-size: clamp(17px, 1.8vw, 20px); margin: 16px 0 20px; max-width: 70ch; }
  .diff { position: relative; display: grid; gap: 2px; }
  .diff .old { display: none; color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); font-size: .78em; padding: 4px 10px; border-radius: 6px; }
  .diff .sg { display: none; margin-right: 10px; font-weight: 700; }
  .diff .new { border-radius: 6px; padding: 0; }
  .diff.play .old, .diff.show .old { display: block; } .diff.play .sg, .diff.show .sg { display: inline; }
  .diff.play:not(.strike) .new { display: none; }
  .diff.strike .old { text-decoration: line-through; opacity: .7; transition: opacity .5s; }
  .diff.strike .new, .diff.show .new { background: color-mix(in srgb, var(--success) 12%, transparent); color: var(--text); padding: 4px 10px; animation: wipe .8s var(--ease) both; } .diff.show .new .sg, .diff.strike .new .sg { color: var(--success); }
  .diff.show .old { text-decoration: line-through; opacity: .7; }
  @keyframes wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .dtoggle { position: absolute; right: 0; top: -22px; background: none; border: 1px solid var(--border); color: var(--muted); border-radius: 8px; font-size: 11px; padding: 2px 8px; cursor: pointer; min-height: 24px; } .dtoggle:hover, .dtoggle[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 0; padding: 20px 0; border-block: 1px solid var(--border); }
  dt { font: 500 11px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  dd { margin: 0; color: var(--muted); font-size: 15px; }
  .foot { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; margin-top: 20px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; } .act { display: flex; gap: 10px; flex-wrap: wrap; }
  .under { margin-top: 20px; padding: 18px 20px; border: 1px dashed var(--border); border-radius: 12px; background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
  .under h4, .under h5 { font: 500 11px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 0 0 8px; }
  .under .flow { display: flex; flex-wrap: wrap; gap: 8px; color: var(--text); font-size: 13px; margin-bottom: 16px; }
  .under .flow span { border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; background: var(--surface); } .under .flow b { color: var(--accent); margin-right: 6px; font-weight: 500; }
  .under .cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 20px; } .under ul { margin: 0; padding-left: 18px; display: grid; gap: 8px; color: var(--muted); font-size: 14px; } .under li b { color: var(--text); font-weight: 600; }
  @media (max-width: 860px) { .under .cols { grid-template-columns: 1fr; } }
  .more { margin: 56px 0 16px; font-size: 20px; }
  .minor { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .minor .what { font-size: 16px; margin: 12px 0 8px; } .res { color: var(--muted); font-size: 14px; margin-bottom: 14px; }
  .ext { color: var(--accent); font: 500 13px var(--font-mono); }
  @media (max-width: 860px) { dl { grid-template-columns: 1fr; } .minor { grid-template-columns: 1fr; } .dates { margin-left: 0; width: 100%; } }
</style>
