---
import Portrait from "./Portrait.astro";
import { person, heroOptions, heroIndex, heroSub, cta, proof } from "../data/content";
const lines = heroOptions[heroIndex];
---
<section class="hero" id="top" data-chapter="Intro" aria-labelledby="hero-h">
  <div class="wrap recruiter-only rsum">
    <p class="eyebrow">{person.focus} · {person.location}</p>
    <h2>{person.name}, {person.title}</h2>
    <p>Currently Senior Software Engineer at {person.current.company}. Five years of backend and distributed-systems engineering across Sandvine, 1mg, ObserveAI, CoinTracker and Credibly. Flagship projects: Rupee Engine and System Design Playground.</p>
    <p class="act"><a class="btn primary" href={person.linkedin} target="_blank" rel="noopener">Message on LinkedIn</a>{person.resumeUrl && <a class="btn" href={person.resumeUrl} target="_blank" rel="noopener">Resume (PDF)</a>}<a class="btn" href="/experience">Experience</a><a class="btn" href={person.github} target="_blank" rel="noopener">GitHub</a></p>
  </div>
  <div class="wrap grid hide-recruiter">
    <div class="copy">
      <p class="eyebrow">{person.title} · {person.focus}</p>
      <h1 id="hero-h">
        {lines.map((l, i) => <span class={i === lines.length - 1 ? "line last" : "line"} style={`--i:${i}`}>{l}</span>)}
      </h1>
      <p class="sub">{heroSub}</p>
      <ul class="facts" aria-label="Key facts and links">
        <li><span class="pl"><span aria-hidden="true">📍</span> {person.location}</span></li>
        <li><a href="/experience">{person.current.title} · {person.current.company}</a></li>
        {person.resumeUrl && <li><a href={person.resumeUrl} target="_blank" rel="noopener" data-resume>Resume (PDF) ↓</a></li>}
        <li><a href={person.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li><a href={person.github} target="_blank" rel="noopener">GitHub ↗</a></li>
      </ul>
      <div class="ctas">
        <a class="btn primary" href={person.linkedin} target="_blank" rel="noopener">{cta.primary} →</a>
        <a class="btn" href={cta.secondaryHref}>{cta.secondary} ↓</a>
        <button type="button" class="btn quick" data-mode="recruiter" title="A compact summary with no motion">⚡ 60-second view</button>
        <button type="button" class="btn ghost" data-open="tldr">30-second version</button>
      </div>
    </div>
    <div class="art hide-recruiter"><Portrait /></div>
  </div>
  <ul class="wrap proof" aria-label="At a glance">
    {proof.map((p) => <li><b>{p.k}</b><span>{p.v}</span></li>)}
  </ul>
</section>
<style>
  .hero { padding: clamp(32px, 6vw, 72px) 0 clamp(32px, 5vw, 56px); overflow-x: clip; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 24px; align-items: center; }
  .copy { min-width: 0; }
  h1 { font-size: clamp(28px, 3.9vw, 54px); font-weight: 800; margin-top: 20px; line-height: .98; letter-spacing: -.035em; }
  .line { display: block; animation: rise .7s var(--ease) both; animation-delay: calc(var(--i) * 90ms); }
  .line.last { color: var(--accent); }
  .sub { color: var(--muted); font-size: clamp(16px, 1.6vw, 19px); max-width: 52ch; margin-top: 22px; }
  .facts { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .facts li { font: 500 13px var(--font-mono); border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text); overflow: hidden; }
  .facts a, .facts .pl { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; text-decoration: none; } .facts a:hover { color: var(--accent); background: var(--accent-soft); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .btn.quick { border-color: var(--accent); color: var(--accent); } .btn.ghost { border-color: transparent; background: none; color: var(--muted); text-decoration: underline; text-underline-offset: 4px; }
  .rsum h2 { font-size: clamp(26px, 4vw, 40px); margin: 12px 0; } .rsum p { color: var(--muted); max-width: 62ch; } .rsum .act { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .proof { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--border); }
  .proof li { display: flex; flex-direction: column; gap: 4px; }
  .proof b { font: 700 clamp(22px, 3vw, 32px) var(--font-display); letter-spacing: -.02em; }
  .proof span { color: var(--muted); font-size: 13px; line-height: 1.4; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 860px) {
    /* Mobile order: words and links first, then the numbers, the ASCII art last so it never pushes key info down. */
    .hero { display: flex; flex-direction: column; }
    .grid { display: contents; }
    .copy { order: 1; width: 100%; max-width: var(--max); margin-inline: auto; padding-inline: var(--gutter); }
    .proof { order: 2; width: 100%; margin-inline: auto; grid-template-columns: repeat(2, 1fr); }
    .art { order: 3; width: 100%; padding: 12px var(--gutter) 0; display: flex; justify-content: center; }
    h1 { font-size: clamp(28px, 8.4vw, 44px); }
  }
</style>
