---
import Portrait from "./Portrait.astro";
import { person, heroOptions, heroIndex, heroSub, cta, proof } from "../data/content";
const lines = heroOptions[heroIndex];
const links = [["GitHub", person.github], ["LinkedIn", person.linkedin], ["Email", `mailto:${person.email}`]];
---
<section class="hero" id="top" data-chapter="Intro" aria-labelledby="hero-h">
  <div class="wrap recruiter-only rsum">
    <p class="eyebrow">{person.focus} · {person.location}</p>
    <h2>{person.name}, {person.title}</h2>
    <p>5 years of backend and distributed-systems engineering across Sandvine, 1mg, ObserveAI and CoinTracker. Flagship project: Rupee Engine.</p>
    <p class="act"><a class="btn primary" href={`mailto:${person.email}`}>Email</a><a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a><a class="btn" href={person.github} target="_blank" rel="noopener">GitHub</a>{person.resumeUrl && <a class="btn" href={person.resumeUrl} target="_blank" rel="noopener">Resume</a>}</p>
  </div>
  <div class="wrap grid hide-recruiter">
    <div class="copy">
      <p class="eyebrow">{person.title} · {person.focus} · {person.location}</p>
      <h1 id="hero-h">
        {lines.map((l, i) => <span class={i === lines.length - 1 ? "line last" : "line"} style={`--i:${i}`}>{l}</span>)}
      </h1>
      <p class="sub">{heroSub}</p>
      <div class="ctas">
        <a class="btn primary" href={cta.primaryHref}>{cta.primary} →</a>
        <a class="btn" href={cta.secondaryHref}>{cta.secondary} ↓</a>
        <button type="button" class="btn" data-open="tldr">30-second version</button>
        {person.resumeUrl && <a class="btn" href={person.resumeUrl} target="_blank" rel="noopener" data-resume>View resume →</a>}
      </div>
      <p class="links">{links.map(([t, h]) => <a href={h} target={h.startsWith("http") ? "_blank" : undefined} rel="noopener">{t}</a>)}</p>
    </div>
    <div class="hide-recruiter"><Portrait /></div>
  </div>
  <ul class="wrap proof" aria-label="At a glance">
    {proof.map((p) => <li><b>{p.k}</b><span>{p.v}</span></li>)}
  </ul>
</section>
<style>
  .hero { padding: clamp(32px, 6vw, 72px) 0 clamp(32px, 5vw, 56px); overflow-x: clip; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 24px; align-items: center; }
  .copy { min-width: 0; }
  h1 { font-size: clamp(28px, 3.9vw, 54px); font-weight: 800; margin-top: 20px; line-height: .98; letter-spacing: -.035em; }
  .line { display: block; animation: rise .7s var(--ease) both; animation-delay: calc(var(--i) * 90ms); }
  .line.last { color: var(--accent); }
  .sub { color: var(--muted); font-size: clamp(16px, 1.6vw, 19px); max-width: 52ch; margin-top: 24px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .links { display: flex; gap: 20px; margin-top: 20px; font: 500 13px var(--font-mono); }
  .links a { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--border); }
  .links a:hover { color: var(--accent); border-color: var(--accent); }
  .rsum h2 { font-size: clamp(26px, 4vw, 40px); margin: 12px 0; } .rsum p { color: var(--muted); max-width: 62ch; } .rsum .act { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .proof { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--border); }
  .proof li { display: flex; flex-direction: column; gap: 4px; }
  .proof b { font: 700 clamp(22px, 3vw, 32px) var(--font-display); letter-spacing: -.02em; }
  .proof span { color: var(--muted); font-size: 13px; line-height: 1.4; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 860px) { .grid { grid-template-columns: minmax(0, 1fr); } h1 { font-size: clamp(28px, 8.4vw, 44px); } .proof { grid-template-columns: repeat(2, 1fr); } }
</style>
