---
import { projects } from "../data/content";
interface Props { title?: string; eyebrow?: string; lede?: string }
const { title = "Selected work", eyebrow = "Work", lede } = Astro.props;
const hue: Record<string, string> = { "rupee-engine": "#4cc2ff", "system-design-playground": "#7c9cff", "aov-studios": "#34d3a0", "bot-detection": "#ff7aa8" };
---
<section id="work" aria-label="Selected work" data-chapter="Work">
  <div class="wrap head">
    <header class="reveal"><p class="eyebrow">{eyebrow}</p><h2 class="h2">{title}</h2>{lede && <p class="lede">{lede}</p>}</header>
    <div class="arrows" aria-hidden="true"><button type="button" data-dir="-1" tabindex="-1" aria-label="Scroll left">←</button><button type="button" data-dir="1" tabindex="-1" aria-label="Scroll right">→</button></div>
  </div>
  <div class="row" data-row tabindex="0" role="group" aria-label="Projects, scroll horizontally">
    {projects.map((p) => {
      const Tag = p.page || p.href ? "a" : "div";
      return (
        <Tag class="poster" href={p.page ?? p.href} target={!p.page && p.href ? "_blank" : undefined} rel={!p.page && p.href ? "noopener" : undefined} style={`--h:${hue[p.slug] ?? "#4cc2ff"}`} data-event="project_opened">
          <div class="art" aria-hidden="true">
            {p.slug === "rupee-engine" && (
              <svg viewBox="0 0 240 150"><g class="bars">{[34, 58, 44, 82, 66, 104, 90].map((h, i) => <rect x={16 + i * 31} y={140 - h} width="20" height={h} rx="4" style={`--d:${i * 70}ms`} />)}</g><path class="line" d="M20 110 L52 88 L83 98 L114 62 L145 76 L176 38 L207 48" /><text x="190" y="30" class="rs">₹</text></svg>
            )}
            {p.slug === "system-design-playground" && (
              <svg viewBox="0 0 240 150"><g class="wires"><path d="M28 75 H78" /><path d="M78 75 L130 38 H176" /><path d="M78 75 L130 112 H176" /><path d="M176 38 L212 75" /><path d="M176 112 L212 75" /></g><g class="nodes"><circle cx="24" cy="75" r="11" /><rect x="66" y="63" width="24" height="24" rx="6" /><rect x="164" y="26" width="24" height="24" rx="6" /><rect x="164" y="100" width="24" height="24" rx="6" class="bad" /><ellipse cx="216" cy="75" rx="12" ry="14" /></g></svg>
            )}
            {p.slug === "aov-studios" && (
              <svg viewBox="0 0 240 150"><rect x="20" y="14" width="200" height="122" rx="10" class="frame" /><rect x="20" y="14" width="200" height="20" rx="10" class="frame" /><g class="blocks"><rect x="34" y="46" width="110" height="14" rx="4" /><rect x="34" y="68" width="150" height="8" rx="3" /><rect x="34" y="84" width="130" height="8" rx="3" /><rect x="34" y="104" width="56" height="20" rx="10" class="cta" /><rect x="156" y="46" width="52" height="78" rx="6" /></g></svg>
            )}
            {p.slug === "bot-detection" && (
              <svg viewBox="0 0 240 150"><g class="wires"><path d="M120 75 L60 40" /><path d="M120 75 L60 110" /><path d="M120 75 L180 38" /><path d="M120 75 L186 112" /><path d="M60 40 L28 70" /><path d="M186 112 L214 80" /><path d="M180 38 L214 62" /></g><g class="nodes"><circle cx="120" cy="75" r="14" class="bad" /><circle cx="60" cy="40" r="9" class="bad" /><circle cx="60" cy="110" r="9" class="bad" /><circle cx="180" cy="38" r="9" /><circle cx="186" cy="112" r="9" /><circle cx="28" cy="70" r="6" /><circle cx="214" cy="80" r="6" /><circle cx="214" cy="62" r="6" /></g></svg>
            )}
          </div>
          <div class="body">
            <p class="meta mono"><span>{p.tag}</span><span>{p.dates}</span></p>
            <h3>{p.name}</h3>
            <p class="what">{p.what}</p>
            <div class="more"><p>{p.how}</p><p class="go mono">{p.page ? "Open case study →" : p.href ? "Visit site ↗" : p.result}</p></div>
          </div>
        </Tag>
      );
    })}
  </div>
  <div class="wrap"><p class="all"><a class="btn" href="/work">All work &amp; case studies →</a></p></div>
</section>
<script>
  document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
    const sec = row.closest("section")!;
    sec.querySelectorAll<HTMLButtonElement>(".arrows button").forEach((b) => b.addEventListener("click", () => row.scrollBy({ left: Number(b.dataset.dir) * Math.min(row.clientWidth * 0.8, 680), behavior: "smooth" })));
  });
</script>
<style>
  .head { display: flex; align-items: end; justify-content: space-between; gap: 20px; }
  .arrows { display: flex; gap: 8px; } .arrows button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; font-size: 18px; transition: border-color var(--dur), transform var(--dur) var(--ease); } .arrows button:hover { border-color: var(--accent); transform: scale(1.08); }
  @media (hover: none) { .arrows { display: none; } }
  .row { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 36px max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))) 28px; scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); scrollbar-width: none; }
  .row::-webkit-scrollbar { display: none; }
  .poster { flex: 0 0 min(320px, 80vw); scroll-snap-align: start; border: 1px solid var(--border); border-radius: 18px; background: var(--surface); text-decoration: none; color: inherit; overflow: hidden; display: flex; flex-direction: column; transition: transform .35s var(--ease), border-color var(--dur), box-shadow .35s var(--ease); position: relative; }
  .poster:hover, .poster:focus-visible { transform: translateY(-8px) scale(1.03); border-color: color-mix(in srgb, var(--h) 60%, var(--border)); box-shadow: 0 26px 50px -24px color-mix(in srgb, var(--h) 55%, transparent); z-index: 2; }
  .art { aspect-ratio: 16 / 10; background: radial-gradient(120% 100% at 30% 0%, color-mix(in srgb, var(--h) 24%, var(--surface-2)), var(--surface-2)); display: grid; place-items: center; border-bottom: 1px solid var(--border); }
  .art svg { width: 88%; height: auto; overflow: visible; }
  .body { padding: 18px 20px 22px; display: grid; gap: 8px; }
  .meta { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  h3 { font-size: 24px; } .what { color: var(--muted); font-size: 15px; }
  .more { display: grid; gap: 10px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height .4s var(--ease), opacity .3s; color: var(--muted); font-size: 14px; }
  .poster:hover .more, .poster:focus-visible .more { max-height: 200px; opacity: 1; margin-top: 6px; }
  @media (hover: none) { .more { max-height: none; opacity: 1; margin-top: 6px; } }
  .go { color: var(--h); font-size: 12px; }
  .all { margin-top: 8px; }

  /* poster art: all idle by default, alive on hover/focus (and always static-readable) */
  svg .bars rect { fill: color-mix(in srgb, var(--h) 55%, var(--surface-2)); transform-box: fill-box; transform-origin: bottom; }
  svg .line { fill: none; stroke: var(--h); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 340; stroke-dashoffset: 0; }
  svg .rs { fill: var(--h); font: 700 26px var(--font-display); opacity: .9; }
  .poster:hover .bars rect { animation: grow .7s var(--ease) backwards; animation-delay: var(--d); } @keyframes grow { from { transform: scaleY(.1); } }
  .poster:hover .line { animation: draw 1.1s var(--ease) both; } @keyframes draw { from { stroke-dashoffset: 340; } }
  svg .wires path { fill: none; stroke: color-mix(in srgb, var(--h) 70%, var(--muted)); stroke-width: 2; stroke-dasharray: 5 7; animation: flow 1.2s linear infinite; animation-play-state: paused; }
  .poster:hover .wires path, .poster:focus-visible .wires path { animation-play-state: running; } @keyframes flow { to { stroke-dashoffset: -24; } }
  svg .nodes > * { fill: var(--surface); stroke: var(--h); stroke-width: 2.5; }
  svg .nodes .bad { stroke: var(--danger); } .poster:hover .nodes .bad { animation: blink .9s steps(2) infinite; } @keyframes blink { 50% { fill: color-mix(in srgb, var(--danger) 40%, var(--surface)); } }
  svg .frame { fill: var(--surface); stroke: var(--border); stroke-width: 2; }
  svg .blocks rect { fill: color-mix(in srgb, var(--h) 35%, var(--surface-2)); } svg .blocks .cta { fill: var(--h); }
  .poster:hover .blocks rect { animation: shimmer 1.4s ease-in-out infinite; } @keyframes shimmer { 50% { opacity: .45; } }
  @media (prefers-reduced-motion: reduce) { .poster, .poster * { animation: none !important; } }
</style>
