---
import art from "../data/portrait.txt?raw";
---
<!-- ASCII portrait generated by scripts/make_portrait.py (structure-based glyph matching). Two layers: dim base + bright layer revealed around the cursor. -->
<figure class="portrait" role="img" aria-label="ASCII-art portrait of a cool character wearing sunglasses">
  <div class="stack" aria-hidden="true"><pre class="base">{art}</pre><pre class="lit">{art}</pre></div>
</figure>
<style>
  .portrait { margin: 0; justify-self: end; max-width: 100%; position: relative; transform: perspective(900px) rotateY(var(--ry, 0deg)) rotateX(var(--rx, 0deg)); transition: transform .3s var(--ease); will-change: transform; }
  .stack { display: grid; -webkit-mask-image: linear-gradient(#000 72%, transparent 100%); mask-image: linear-gradient(#000 72%, transparent 100%); }
  pre { grid-area: 1 / 1; margin: 0; font: 500 clamp(5px, 1.2vw, 9.2px)/1 var(--font-mono); white-space: pre; overflow: hidden; }
  .base { color: color-mix(in srgb, var(--accent) 34%, var(--bg)); }
  .lit { color: var(--accent); text-shadow: 0 0 10px color-mix(in srgb, var(--accent) 70%, transparent); -webkit-mask-image: radial-gradient(circle 150px at var(--px, 50%) var(--py, 40%), #000 0%, transparent 100%); mask-image: radial-gradient(circle 150px at var(--px, 50%) var(--py, 40%), #000 0%, transparent 100%); }
  .portrait :global(.row) { opacity: 0; animation: row .5s var(--ease) forwards; animation-delay: calc(var(--i) * 28ms + 300ms); }
  @keyframes row { from { opacity: 0; filter: blur(3px); } to { opacity: 1; filter: none; } }
  .portrait::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, color-mix(in srgb, var(--accent) 28%, transparent) 50%, transparent 60%); background-size: 100% 300%; mix-blend-mode: screen; pointer-events: none; animation: scan 7s ease-in-out 2.4s infinite; -webkit-mask-image: linear-gradient(#000 70%, transparent); mask-image: linear-gradient(#000 70%, transparent); }
  @keyframes scan { 0% { background-position: 0 100%; opacity: 0; } 10% { opacity: 1; } 45% { background-position: 0 0; opacity: 0; } 100% { opacity: 0; } }
  @media (max-width: 860px) { .portrait { justify-self: center; } pre { font-size: calc((100vw - 2 * var(--gutter)) / 60); } }
</style>
