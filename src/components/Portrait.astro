---
import art from "../data/portrait.txt?raw";
---
<!-- ASCII portrait generated by scripts/make_portrait.py (structure-based glyph matching). TODO(tone): sunglasses are part of the source art. -->
<figure class="portrait" role="img" aria-label="ASCII-art portrait of a cool character wearing small round sunglasses">
  <pre aria-hidden="true">{art}</pre>
</figure>
<style>
  .portrait { margin: 0; justify-self: end; max-width: 100%; }
  pre { margin: 0; font: 500 clamp(5px, 1.2vw, 9.2px)/1 var(--font-mono); color: var(--accent); white-space: pre; overflow: hidden; -webkit-mask-image: linear-gradient(#000 72%, transparent 100%); mask-image: linear-gradient(#000 72%, transparent 100%); text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 35%, transparent); }
  .portrait { transition: transform .4s var(--ease); position: relative; }
  .portrait :global(.row) { opacity: 0; animation: row .5s var(--ease) forwards; animation-delay: calc(var(--i) * 28ms + 300ms); }
  @keyframes row { from { opacity: 0; filter: blur(3px); } to { opacity: 1; filter: none; } }
  .portrait::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, color-mix(in srgb, var(--accent) 28%, transparent) 50%, transparent 60%); background-size: 100% 300%; mix-blend-mode: screen; pointer-events: none; animation: scan 7s ease-in-out 2.4s infinite;  }
  @keyframes scan { 0% { background-position: 0 100%; opacity: 0; } 10% { opacity: 1; } 45% { background-position: 0 0; opacity: 0; } 100% { opacity: 0; } }
  @media (max-width: 860px) { .portrait { justify-self: center; } pre { font-size: calc((100vw - 2 * var(--gutter)) / 60); } }
</style>
