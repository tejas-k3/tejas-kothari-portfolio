---
import art from "../data/portrait.txt?raw";
---
<!-- ASCII portrait generated by scripts/image_to_ascii.py. TODO(tone): sunglasses are part of the source art. -->
<figure class="portrait" role="img" aria-label="ASCII-art portrait of a cool character wearing small round sunglasses">
  <pre aria-hidden="true">{art}</pre>
</figure>
<style>
  .portrait { margin: 0; justify-self: end; max-width: 100%; }
  pre { margin: 0; font: 500 clamp(5px, 1.15vw, 9px)/1 var(--font-mono); color: var(--accent); letter-spacing: 0; white-space: pre; overflow: hidden;
    -webkit-mask-image: linear-gradient(#000 70%, transparent 100%); mask-image: linear-gradient(#000 70%, transparent 100%);
    text-shadow: 0 0 14px color-mix(in srgb, var(--accent) 35%, transparent); }
  @media (max-width: 860px) { .portrait { justify-self: center; } pre { font-size: clamp(4px, 1.9vw, 8px); } }
</style>
