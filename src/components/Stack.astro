---
import SectionHead from "./SectionHead.astro";
import { stack } from "../data/content";

// Concept glyphs (no brand logo exists): simple 24x24 stroke icons, drawn to match the logo weight.
const glyphs: Record<string, string> = {
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
  nodes: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M11 7l-5 9M13 7l5 9M7.3 18h9.4"/>',
  blocks: '<rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><path d="M17 13v8M13 17h8"/>',
  blueprint: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11M14 14h4"/>',
  logs: '<path d="M4 6h16M4 11h11M4 16h16M4 21h8"/>',
  tree: '<circle cx="12" cy="5" r="2.2"/><circle cx="6" cy="14" r="2.2"/><circle cx="18" cy="14" r="2.2"/><circle cx="3.5" cy="21" r="1.6"/><circle cx="8.5" cy="21" r="1.6"/><path d="M11 7l-4 5M13 7l4 5M5 16l-1 3.5M7 16l1 3.5"/>',
  cores: '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
};
---
<section id="stack" data-chapter="Stack" aria-label="Tech stack">
  <div class="wrap">
    <SectionHead eyebrow="Tech stack" title="What I build with." />
    <div class="groups">
      {stack.map((g) => (
        <div class="group reveal">
          <h3 class="mono">{g.group}</h3>
          <ul class="grid">
            {g.items.map((t) => (
              <li class="tile" style={`--c:${t.c};--cd:${t.cd ?? t.c}`}>
                {t.logo.startsWith("glyph:")
                  ? <svg class="gl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[t.logo.slice(6)]} />
                  : <i class="logo" aria-hidden="true" style={`--src:url(/logos/${t.logo}.svg)`}></i>}
                <span>{t.name}</span>
                <small class="eng-only">{t.used.join(" · ")}</small>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .tile { --tint: var(--c); }
  :global(:root[data-theme="dark"]) .tile { --tint: var(--cd); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .tile { --tint: var(--cd); } }
  .logo { display: block; width: 36px; height: 36px; background: var(--tint); -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; }
  .groups { display: grid; gap: 36px; margin-top: 40px; }
  h3 { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 14px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 108px; padding: 12px 8px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); color: var(--text); font: 500 13px/1.25 var(--font-body); text-align: center; position: relative; overflow: hidden; transition: transform var(--dur) var(--ease), border-color var(--dur), box-shadow var(--dur); }
  .tile::after { content: ""; position: absolute; inset: 0; background: radial-gradient(110px circle at 50% 0%, color-mix(in srgb, var(--tint) 16%, transparent), transparent 70%); pointer-events: none; }
  .tile small { font: 400 10.5px/1.3 var(--font-mono); color: var(--muted); }
  .tile .gl { width: 36px; height: 36px; color: var(--tint); }
  .tile:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--tint) 55%, var(--border)); box-shadow: 0 12px 28px -16px color-mix(in srgb, var(--tint) 60%, transparent); }
  @media (max-width: 560px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; } .tile { height: 96px; font-size: 12px; } .logo, .tile .gl { width: 30px; height: 30px; } }
</style>
