---
import SectionHead from "./SectionHead.astro";
import { stack } from "../data/content";

// Concept glyphs (no brand logo exists): simple 24x24 stroke icons, drawn to match the logo weight.
const glyphs: Record<string, string> = {
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
  nodes: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M11 7l-5 9M13 7l5 9M7.3 18h9.4"/>',
  blocks: '<rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><path d="M17 13v8M13 17h8"/>',
  blueprint: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11M14 14h4"/>',
  logs: '<path d="M4 6h16M4 11h11M4 16h16M4 21h8"/>',
  tree: '<circle cx="12" cy="5" r="2.2"/><circle cx="6" cy="14" r="2.2"/><circle cx="18" cy="14" r="2.2"/><circle cx="3.5" cy="21" r="1.6"/><circle cx="8.5" cy="21" r="1.6"/><path d="M11 7l-4 5M13 7l4 5M5 16l-1 3.5M7 16l1 3.5"/>',
  cores: '<rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
};
const all = stack.flatMap((g) => g.items);
const marquee = all.filter((t) => !t.logo.startsWith("glyph:"));
---
<section id="stack" aria-label="Tech stack">
  <div class="wrap">
    <SectionHead eyebrow="Tech stack" title="Tools, and where I've used them." lede="Tap any technology to see the work behind it." />
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => marquee.map((t) => (
        <span class="mq" style={`--c:${t.c};--cd:${t.cd ?? t.c}`}><i class="logo" style={`--src:url(/logos/${t.logo}.svg)`}></i>{t.name}</span>
      )))}
    </div>
  </div>

  <div class="wrap">
    <div class="groups">
      {stack.map((g) => (
        <div class="group reveal">
          <h3 class="mono">{g.group}</h3>
          <div class="grid" style={`--cols:${g.items.length <= 8 ? g.items.length : 6}`}>
            {g.items.map((t) => (
              <button type="button" class="tile" aria-pressed="false" data-name={t.name} data-used={JSON.stringify(t.used)} style={`--c:${t.c};--cd:${t.cd ?? t.c}`}>
                {t.logo.startsWith("glyph:")
                  ? <svg class="gl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[t.logo.slice(6)]} />
                  : <i class="logo" aria-hidden="true" style={`--src:url(/logos/${t.logo}.svg)`}></i>}
                <span>{t.name}</span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="detail card" id="stack-detail" role="status" aria-live="polite"><span class="mono">Select a technology.</span></div>
  </div>
</section>
<script>
  const detail = document.getElementById("stack-detail")!;
  const tiles = document.querySelectorAll<HTMLButtonElement>(".tile");
  tiles.forEach((b) => b.addEventListener("click", () => {
    tiles.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    const used: string[] = JSON.parse(b.dataset.used || "[]");
    detail.replaceChildren();
    const t = document.createElement("strong"); t.textContent = b.dataset.name || "";
    const u = document.createElement("span"); u.className = "mono"; u.textContent = "  →  " + used.join("  ·  ");
    detail.append(t, u);
    b.style.setProperty("--pop", "1"); setTimeout(() => b.style.removeProperty("--pop"), 400);
  }));
</script>
<style>
  :root { --tint: var(--c); }
  .tile, .mq { --tint: var(--c); }
  :global(:root[data-theme="dark"]) .tile, :global(:root[data-theme="dark"]) .mq { --tint: var(--cd); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .tile, :global(:root:not([data-theme="light"])) .mq { --tint: var(--cd); } }

  .logo { display: block; width: 32px; height: 32px; background: currentColor; -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; transition: background var(--dur), transform var(--dur) var(--ease); }

  .marquee { margin: 40px 0 8px; overflow: hidden; border-block: 1px solid var(--border); padding: 16px 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 40px; width: max-content; animation: scroll 55s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .mq { display: inline-flex; align-items: center; gap: 12px; color: var(--muted); font: 500 15px var(--font-body); white-space: nowrap; }
  .mq .logo { width: 24px; height: 24px; }
  .mq:hover { color: var(--tint); }
  @keyframes scroll { to { transform: translateX(-50%); } }

  .groups { display: grid; gap: 40px; margin-top: 32px; }
  h3 { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 500; margin-bottom: 14px; }
  .grid { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 12px; width: min(100%, calc(var(--cols) * 210px)); }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; } }
  .tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 112px; padding: 16px 10px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); color: var(--muted); cursor: pointer; font: 500 13px/1.25 var(--font-body); text-align: center; position: relative; overflow: hidden; transition: transform var(--dur) var(--ease), border-color var(--dur), color var(--dur), box-shadow var(--dur); }
  .tile::after { content: ""; position: absolute; inset: 0; background: radial-gradient(120px circle at 50% 0%, color-mix(in srgb, var(--tint) 22%, transparent), transparent 70%); opacity: 0; transition: opacity var(--dur); pointer-events: none; }
  .tile .gl { width: 32px; height: 32px; }
  .tile:hover, .tile[aria-pressed="true"] { transform: translateY(-4px); color: var(--text); border-color: color-mix(in srgb, var(--tint) 60%, var(--border)); box-shadow: 0 12px 30px -14px color-mix(in srgb, var(--tint) 55%, transparent); }
  .tile:hover::after, .tile[aria-pressed="true"]::after { opacity: 1; }
  .tile:hover .logo, .tile[aria-pressed="true"] .logo, .tile:hover .gl, .tile[aria-pressed="true"] .gl { color: var(--tint); background-color: var(--tint); transform: scale(1.12); }
  .tile:hover .gl, .tile[aria-pressed="true"] .gl { background: none; }
  .tile .gl { transition: color var(--dur), transform var(--dur) var(--ease); }
  .detail { margin-top: 28px; font-size: 15px; padding: 18px 22px; } .detail strong { color: var(--accent); } .detail .mono { color: var(--muted); font-size: 14px; }
  @media (max-width: 560px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; } .tile { min-height: 96px; font-size: 12px; } .logo, .tile .gl { width: 28px; height: 28px; } }
</style>
