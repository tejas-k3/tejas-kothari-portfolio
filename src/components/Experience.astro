---
import { experience, education, person } from "../data/content";
---
<section id="experience" data-chapter="Experience" aria-label="Experience">
  <div class="wrap">
    <ol class="tl" data-draw>
      {experience.map((e, n) => (
        <li class="reveal" style={`--n:${n}`}>
          <span class="when mono">{e.current ? "Current role" : `${e.from} – ${e.to}`}</span>
          <div class="role">
            <h2>{e.company}{e.current && <span class="now mono">now</span>}</h2>
            <p class="title">{e.title}</p>
            {e.points.length > 0 && (
              <ul class="pts">
                {e.points.map((p) => <li>{p.m && <b class="m mono">{p.m}</b>}<span>{p.t}</span></li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
      <li class="reveal edu" style={`--n:${experience.length}`}><span class="when mono">{education.from} – {education.to}</span><div class="role"><h2>{education.school}</h2><p class="title">{education.degree}</p></div></li>
    </ol>
    <p class="cta-row">{person.resumeUrl && <a class="btn" href={person.resumeUrl} target="_blank" rel="noopener" data-resume>Download resume (PDF) ↓</a>} <a class="btn" href="/resume">View as a web page</a> <a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></p>
  </div>
</section>
<style>
  .tl { list-style: none; margin: 40px 0 0; padding: 0; position: relative; }
  .tl::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; background: var(--border); }
  .tl::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; margin-left: -.5px; background: linear-gradient(var(--accent), transparent); transform-origin: top; transform: scaleY(0); transition: transform 1.6s var(--ease); }
  :global(.tl.in)::after { transform: scaleY(1); }
  .tl > li { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 20px; padding: 24px 0 24px 28px; position: relative; }
  .tl > li::before { content: ""; position: absolute; left: -5px; top: 34px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  :global(.js) .tl > li::before { transform: scale(0); transition: transform .5s var(--ease) calc(var(--n, 0) * 220ms + 200ms); } :global(.tl.in) > li::before { transform: scale(1); }
  .edu::before { background: var(--border) !important; }
  .when { color: var(--muted); font-size: 13px; padding-top: 6px; }
  h2 { font-size: 26px; display: flex; align-items: center; gap: 10px; } .now { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-ink); background: var(--accent); border-radius: 999px; padding: 2px 10px; }
  .title { margin-top: 4px; font-weight: 500; }
  .pts { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 12px; }
  .pts li { display: grid; gap: 4px; color: var(--muted); font-size: 15px; max-width: 74ch; padding-left: 14px; border-left: 2px solid var(--border); transition: border-color var(--dur); } .pts li:hover { border-color: var(--accent); }
  .m { color: var(--accent); font-size: 12px; letter-spacing: .02em; }
  .cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
  @media (max-width: 700px) { .tl > li { grid-template-columns: 1fr; gap: 4px; } }
</style>
