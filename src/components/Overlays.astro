---
import { person, experience, projects, stack, currently } from "../data/content";
// Data for the palette + terminal. Static, public-safe only. No command here executes arbitrary input.
const data = {
  person: { name: person.name, title: person.title, focus: person.focus, location: person.location, email: person.email, github: person.github, linkedin: person.linkedin, resume: person.resumeUrl },
  experience: experience.map((e) => `${e.from} – ${e.to}  ${e.company}, ${e.title}`),
  projects: projects.map((p) => ({ name: p.name, line: p.what, page: p.page ?? p.href ?? p.repo ?? null })),
  stack: stack.map((g) => `${g.group}: ${g.items.map((i) => i.name).join(", ")}`),
  currently: currently.map((c) => `${c.k}: ${c.v}`),
};
---
<dialog id="palette" aria-label="Command palette" class="ov">
  <form method="dialog" class="box">
    <input id="pal-input" type="text" role="combobox" aria-expanded="true" aria-controls="pal-list" aria-autocomplete="list" placeholder="Type a command or search…" autocomplete="off" spellcheck="false" />
    <ul id="pal-list" role="listbox" aria-label="Commands"></ul>
    <p class="hint mono"><kbd>↑</kbd><kbd>↓</kbd> navigate · <kbd>↵</kbd> run · <kbd>esc</kbd> close</p>
  </form>
</dialog>
<dialog id="term" aria-label="Terminal" class="ov term">
  <div class="box">
    <div class="bar mono"><span>tejas@portfolio ~ </span><button type="button" id="term-x" aria-label="Close terminal">esc</button></div>
    <div id="term-out" class="out mono" role="log" aria-live="polite"></div>
    <label class="line mono"><span aria-hidden="true">$</span><input id="term-in" type="text" autocomplete="off" spellcheck="false" aria-label="Terminal command" /></label>
  </div>
</dialog>
<dialog id="tldr" aria-label="30-second version" class="ov">
  <div class="box tldr-box">
    <p class="eyebrow">The 30-second version</p>
    <h2>{person.name}</h2>
    <ul>
      <li><b>Who:</b> {person.title}, {person.focus.toLowerCase()}, {person.location}. Shipping backend systems since 2021.</li>
      <li><b>Where:</b> {experience.map((e) => e.company).join(", ")}.</li>
      <li><b>Flagship:</b> Rupee Engine: 13 pluggable algorithms scoring 1,300+ NSE stocks, with a CLI, API and dashboard.</li>
      <li><b>Open source:</b> System Design Playground: a deterministic Go simulator you can break and fix in the browser.</li>
      <li><b>Style:</b> learns fast, ships with AI-assisted development and keeps tests and judgment in the loop.</li>
    </ul>
    <p class="act"><a class="btn primary" href={`mailto:${person.email}`}>Email me</a><a class="btn" href="/work">See the work</a><a class="btn" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a><button type="button" class="btn" data-close>Close</button></p>
  </div>
</dialog>
<script type="application/json" id="site-data" set:html={JSON.stringify(data)} />
<style is:global>
  .tldr-box { padding: 24px !important; } .tldr-box h2 { font-size: 28px; margin: 10px 0 14px; } .tldr-box ul { padding-left: 18px; display: grid; gap: 10px; color: var(--muted); } .tldr-box b { color: var(--text); } .tldr-box .act { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  dialog.ov { border: 1px solid var(--border); border-radius: 16px; background: var(--surface); color: var(--text); padding: 0; width: min(640px, calc(100vw - 24px)); margin: 12vh auto auto; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  dialog.ov::backdrop { background: rgba(5,6,8,.55); backdrop-filter: blur(3px); }
  dialog.ov .box { margin: 0; padding: 12px; }
  #pal-input { width: 100%; min-height: 48px; border: 0; border-bottom: 1px solid var(--border); background: transparent; color: var(--text); font: 500 17px var(--font-body); padding: 0 12px; outline: none; }
  #pal-list { list-style: none; margin: 8px 0 0; padding: 0; max-height: 50vh; overflow: auto; }
  #pal-list li { padding: 12px; border-radius: 10px; cursor: pointer; display: flex; justify-content: space-between; gap: 12px; min-height: 44px; align-items: center; }
  #pal-list li[aria-selected="true"] { background: var(--accent-soft); }
  #pal-list li small { color: var(--muted); font: 400 12px var(--font-mono); }
  .hint { color: var(--muted); font-size: 12px; margin: 10px 12px 2px; }
  dialog.term { width: min(760px, calc(100vw - 24px)); background: #0a0e14; color: #d8dde6; border-color: #222c3b; }
  .term .bar { display: flex; justify-content: space-between; color: #8b93a1; font-size: 12px; padding: 4px 6px 10px; border-bottom: 1px solid #222c3b; }
  .term .bar button { background: none; border: 1px solid #222c3b; color: #8b93a1; border-radius: 6px; cursor: pointer; font: inherit; min-height: 28px; padding: 0 8px; }
  .term .out { height: min(52vh, 420px); overflow: auto; padding: 12px 6px; font-size: 13px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
  .term .out a { color: #4cc2ff; } .term .out .p { color: #4cc2ff; }
  .term .line { display: flex; gap: 8px; padding: 8px 6px 2px; border-top: 1px solid #222c3b; color: #4cc2ff; font-size: 14px; }
  .term .line input { flex: 1; background: none; border: 0; color: #e8edf5; font: inherit; outline: none; min-height: 32px; }
</style>
