      const clusters: { x: number; y: number; members: string[] }[] = [];
      for (const n of prio) { const p = proj(ll(n)[1], ll(n)[0]); if (!p.vis || p.z <= 0.02) continue; const c = clusters.find((q) => Math.hypot(q.x - p.x, q.y - p.y) < 22); if (c) c.members.push(n); else clusters.push({ x: p.x, y: p.y, members: [n] }); }
      ctx.font = "500 11px ui-monospace, Menlo, monospace"; ctx.textBaseline = "middle"; const placed: { x: number; y: number; w: number; h: number }[] = [];
      clusters.forEach((c) => {
        const lead = c.members[0], isHome = c.members.includes(P.home), isLast = c.members.includes(P.lastTrip), n = c.members.length;
        ctx.beginPath(); ctx.arc(c.x, c.y, n > 1 ? 9 : isHome ? 5 : 3.8, 0, 7); ctx.fillStyle = isLast ? colors.text : colors.accent; ctx.fill();
        if (n > 1) { ctx.fillStyle = colors.bg; ctx.font = "700 10px ui-monospace, Menlo, monospace"; ctx.textAlign = "center"; ctx.fillText(String(n), c.x, c.y + 0.5); ctx.textAlign = "left"; ctx.font = "500 11px ui-monospace, Menlo, monospace"; }
        if (isHome && !reduce) { const k = (t / 1400) % 1; ctx.beginPath(); ctx.arc(c.x, c.y, 8 + k * 16, 0, 7); ctx.strokeStyle = colors.accent; ctx.globalAlpha = 1 - k; ctx.lineWidth = 1.5; ctx.stroke(); ctx.globalAlpha = 1; }
